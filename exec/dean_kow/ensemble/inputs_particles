# *****************************************************************
# Run until nsteps == max_step or time == stop_time,
#     whichever comes first
# *****************************************************************
max_step  = 100 #100000

seed = 1024

amrex.fpe_trap_invalid = 1

# *****************************************************************
# Specific to this application
# *****************************************************************
npts_scale = 1.
alg_type = 1

# *****************************************************************
# Are we restarting from an existing checkpoint file?
# *****************************************************************
#amr.restart  = chk100000 # restart from this checkpoint file

# *****************************************************************
# Problem size and geometry
# *****************************************************************
geometry.prob_lo     =  0.0    0.0
geometry.prob_hi     =  1.0  2048.0
geometry.prob_hi     =  0.1  1000.0
geometry.is_periodic =  1    1
bc_lo = 0 0
bc_hi = 0 0

is_ensemble_dir = 0 1
diffusion_coefficient = 0.5
flux_mode = ml
ml_model_file = model.pt
ml_history_len = 10
ml_history_ngrow = 1
# ML flow-matching settings (used when flux_mode = ml)
# ml_flow_steps: number of Euler steps on t in [ml_flow_t0, ml_flow_t1]
# ml_flow_t0, ml_flow_t1: integration time interval
# ml_t_df, ml_t_loc, ml_t_scale: Student's t parameters for x0 sampling
# ml_input_scale: scales phi/flux inputs before they are fed to the model
# ml_output_mn_fctr, ml_output_std_fctr: rescale model outputs back to flux units
# quantize_ml_output: stochastically round ML net-particle fluxes to integers
ml_flow_steps = 20
ml_flow_t0 = 0.0
ml_flow_t1 = 1.0
ml_t_df = 4.0
ml_t_loc = 0.0
ml_t_scale = 1.0
ml_input_scale = 51.0
ml_output_mn_fctr = 0.069
ml_output_std_fctr = 0.2537
quantize_ml_output = false

ext_pot.exists = 0
remove_particle_history = "false"
remove_hist_freq        = 2

# External-potential-x initialization example.
# This initializes level-0 phi over the x-window `init_x_range` using
# weights proportional to exp(-2 * (V(x,y) - min(V))) and assigns
# `init_total_particles` particles across the selected cells.
# To use this mode, enable the external potential below and switch
# `init_type` to `external_potential_x`.
# init_type = external_potential_x
# init_x_range = 0.25 0.75
# init_total_particles = 10000
# ext_pot.exists = 1
# ext_pot.type = quartic_2d
# ext_pot.alpha = 1.0
# ext_pot.beta = 1.0
# ext_pot.gamma = 0.0
#
# Piecewise-x initialization example.
# `init_positions` splits the x-domain into intervals and
# `init_particles_per_interval` sets the particle count per interval.
# The second array must have exactly one more entry than the first.
#init_type = piecewise_x
#init_positions = 0.3 0.7
#init_particles_per_interval = 25.0 75.0 10.0

# Diagnostics example.
# `diag_flux_x` should map to a valid x-face on the level-0 grid and
# `diag_x_min`/`diag_x_max` define the x-window used for reduced densities.
diag_enable = 1
diag_enable = 0
diag_flux_x = 0.5
diag_x_min = 0.25
diag_x_max = 0.75
diag_file = diag_particles.dat

# *****************************************************************
# VERBOSITY
# *****************************************************************
amr.v              = 1       # verbosity in Amr

# *****************************************************************
# Resolution and refinement
# *****************************************************************

amr.max_grid_size_x = 32 32
amr.max_grid_size_y = 32 32
amr.n_cell          = 100 2048
amr.n_cell          = 10  1000

amr.max_level       = 0
amr.use_particles   = 1      # Turn particles on or off

# *****************************************************************
# Control of grid creation
# *****************************************************************
# Blocking factor for grid creation in each dimension --
#   this ensures that every grid is coarsenable by a factor of 8 --
#   this is mostly relevant for multigrid performance
amr.blocking_factor_x = 2
amr.blocking_factor_y = 2
# *****************************************************************
# Time step control
# *****************************************************************
adv.cfl            = 0.12   # CFL constraint

# *****************************************************************
# Plotfile name and frequency
# *****************************************************************
amr.plot_file  = plt    # root name of plot file
amr.plot_int   =  1    # number of timesteps between plot files
                        # if negative then no plot files will be written

# *****************************************************************
# Checkpoint name and frequency
# *****************************************************************
amr.chk_file = chk      # root name of checkpoint file
amr.chk_int  = 10000    # number of timesteps between checkpoint files
                        # if negative then no checkpoint files will be written
